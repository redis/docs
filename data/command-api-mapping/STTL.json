    "lettuce_sync": [
      {
        "signature": "List<Long> sttl(K key, V... members)",
        "params": [
          {
            "name": "key",
            "type": "K",
            "description": "the key of the set, must not be null."
          },
          {
            "name": "members",
            "type": "V...",
            "description": "the members to get the time to live for, must not be null or empty."
          }
        ],
        "returns": {
          "type": "List<Long>",
          "description": "a list with one Long per member, in the order of members: the remaining time to live in seconds, rounded up to the next second; -1 if the member exists but has no expiration; -2 if the member does not exist (a logically expired member does not exist) or key does not exist."
        }
